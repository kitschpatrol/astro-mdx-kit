{
	"name": "astro-mdx-kit",
	"version": "0.4.1",
	"description": "Astro integration for MDX directive-to-component mapping, element overrides, and auto-imports.",
	"keywords": [
		"astro",
		"astro-integration",
		"mdx",
		"markdown",
		"remark",
		"import",
		"directive",
		"components",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/astro-mdx-kit",
	"bugs": "https://github.com/kitschpatrol/astro-mdx-kit/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/astro-mdx-kit.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./remark": {
			"types": "./dist/remark-plugin.d.ts",
			"import": "./dist/remark-plugin.js"
		},
		"./satteri": {
			"types": "./dist/satteri-plugin.d.ts",
			"import": "./dist/satteri-plugin.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"files": [
		"dist/*"
	],
	"scripts": {
		"build": "tsdown && pnpm run -r --include-workspace-root astro build",
		"clean": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"dev": "pnpm dev-satteri",
		"dev-satteri": "pnpm -C playground-satteri run dev",
		"dev-satteri-starlight": "pnpm -C playground-satteri-starlight run dev",
		"dev-unified": "pnpm -C playground-unified run dev",
		"dev-unified-starlight": "pnpm -C playground-unified-starlight run dev",
		"fix": "ksc fix",
		"lint": "ksc lint && pnpm run -r --include-workspace-root astro check",
		"release": "bumpp --commit 'Release: %s' && pnpm build && NPM_AUTH_TOKEN=$(op read 'op://Personal/npm/token') pnpm publish",
		"test": "vitest run"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.2.2",
		"@astrojs/markdown-satteri": "^0.3.5",
		"@types/mdast": "^4.0.4",
		"hast-util-to-html": "^9.0.5",
		"lognow": "^0.8.0",
		"mdast-util-directive": "^3.1.0",
		"mdast-util-mdx-jsx": "^3.2.0",
		"mdast-util-mdxjs-esm": "^2.0.1",
		"mdast-util-to-hast": "^13.2.1",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"micromark-extension-directive": "^4.0.0",
		"remark-sectionize": "^2.1.0",
		"satteri": "^0.9.5",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"vfile": "^6.0.3"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@astrojs/check": "^0.9.10",
		"@kitschpatrol/shared-config": "^8.6.0",
		"@types/estree": "^1.0.9",
		"@types/node": "~24.13.3",
		"@types/unist": "^3.0.3",
		"astro": "^7.1.6",
		"bumpp": "^12.1.1",
		"node-addon-api": "^8.9.0",
		"node-gyp": "^13.0.1",
		"publint": "^0.3.22",
		"remark-attribute-list": "^0.4.0",
		"remark-directive": "^4.0.0",
		"remark-parse": "^11.0.0",
		"shx": "^0.4.0",
		"tsdown": "^0.22.14",
		"typescript": "~6.0.3",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"astro": "^7.0.6",
		"remark-attribute-list": "^0.4.0",
		"remark-directive": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"astro": {
			"optional": true
		}
	},
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=24.16.0"
	}
}
